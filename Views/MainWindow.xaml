<Window x:Class="Barakhloskop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Barakhloskop.Views"
        xmlns:m="clr-namespace:Barakhloskop.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Барахлоскоп 3000"
        Width="1340" Height="880"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource F.Ui}"
        Closing="OnClosing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding SpinCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyPathCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <v:BoolToVisibilityConverter x:Key="Cv.Bool" />
        <v:NotEmptyToVisibilityConverter x:Key="Cv.NotEmpty" />
        <v:BytesConverter x:Key="Cv.Bytes" />
        <v:AgeConverter x:Key="Cv.Age" />
        <v:KindToBrushConverter x:Key="Cv.KindBrush" />
        <v:CountConverter x:Key="Cv.Count" />
        <v:RatioToStarConverter x:Key="Cv.Star" />

        <!-- Строка в списке находок -->
        <DataTemplate x:Key="Tpl.Finding" DataType="{x:Type m:MediaFile}">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="26" CornerRadius="6"
                        Background="#18FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindGlyph}"
                               FontFamily="{StaticResource F.Mono}"
                               FontSize="9.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Kind, Converter={StaticResource Cv.KindBrush}}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}"
                               Foreground="{StaticResource B.Text}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding FolderName}" Style="{StaticResource T.Caption}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Size, Converter={StaticResource Cv.Bytes}}"
                               Style="{StaticResource T.Mono}" HorizontalAlignment="Right"
                               Foreground="{StaticResource B.Text}" />
                    <TextBlock Text="{Binding Modified, Converter={StaticResource Cv.Age}}"
                               Style="{StaticResource T.Caption}" HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Полоса по типу файлов -->
        <DataTemplate x:Key="Tpl.KindStat" DataType="{x:Type m:KindStat}">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}"
                               Foreground="{StaticResource B.Text}" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource B.Text}" />
                        <TextBlock Text=" · " Style="{StaticResource T.Mono}" />
                        <TextBlock Text="{Binding BytesText}" Style="{StaticResource T.Mono}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Height="6" CornerRadius="3" Background="#14FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource Cv.Star}}" />
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource Cv.Star}, ConverterParameter=rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3" MinWidth="5"
                                Background="{Binding Kind, Converter={StaticResource Cv.KindBrush}}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Папка-рекордсмен -->
        <DataTemplate x:Key="Tpl.Folder" DataType="{x:Type m:FolderStat}">
            <Grid Margin="0,0,0,11" ToolTip="{Binding Path}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}"
                               Foreground="{StaticResource B.Text}" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="180" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Caption}"
                               HorizontalAlignment="Right" />
                </Grid>
                <Border Grid.Row="1" Height="5" CornerRadius="3" Background="#14FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource Cv.Star}}" />
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource Cv.Star}, ConverterParameter=rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3" MinWidth="5"
                                Background="{StaticResource B.Fresh}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Корневая папка в списке источников -->
        <DataTemplate x:Key="Tpl.Root">
            <Grid ToolTip="{Binding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding}" Style="{StaticResource T.Mono}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource B.Text}" />
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        FontSize="9" Width="20" Height="20"
                        Style="{StaticResource S.Btn.Icon}"
                        ToolTip="Убрать из списка"
                        Command="{Binding DataContext.RemoveRootCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- Чип истории показов -->
        <DataTemplate x:Key="Tpl.History" DataType="{x:Type m:MediaFile}">
            <Button Style="{StaticResource S.Btn.Ghost}" Padding="10,7" Margin="0,0,6,0"
                    ToolTip="{Binding Path}"
                    Command="{Binding DataContext.ShowFileCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{Binding Kind, Converter={StaticResource Cv.KindBrush}}" />
                    <TextBlock Text="{Binding Name}" MaxWidth="130"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" BorderThickness="1"
            Background="{StaticResource B.WindowBg}"
            BorderBrush="{StaticResource B.Line}">
        <Grid>
            <!-- Мягкое пятно света сверху -->
            <Border Background="{StaticResource B.Spotlight}" CornerRadius="16" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===================== ЗАГОЛОВОК ОКНА ===================== -->
                <Grid Grid.Row="0" Height="46" Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{StaticResource B.Accent}" Margin="0,0,10,0">
                            <TextBlock Text="Б" FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="БАРАХЛОСКОП" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                        <TextBlock Text="3000" FontSize="12.5" FontWeight="Bold" Margin="5,0,0,0"
                                   Foreground="{StaticResource B.Magenta}" VerticalAlignment="Center" />
                        <Border Background="#18FFFFFF" CornerRadius="999" Padding="8,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="ревизия цифрового барахла" Style="{StaticResource T.Caption}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                        <Button Content="&#xE921;" Style="{StaticResource S.Btn.Chrome}"
                                ToolTip="Свернуть" Click="OnMinimize" />
                        <Button Content="&#xE922;" Style="{StaticResource S.Btn.Chrome}"
                                ToolTip="Развернуть" Click="OnMaximize" />
                        <Button Content="&#xE8BB;" Style="{StaticResource S.Btn.Close}"
                                ToolTip="Закрыть" Click="OnClose" />
                    </StackPanel>
                </Grid>

                <!-- ===================== ПОЛОСА МЕТРИК ===================== -->
                <Grid Grid.Row="1" Margin="16,0,16,14">
                    <Border Style="{StaticResource S.Card}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="НАЙДЕНО ФАЙЛОВ" Style="{StaticResource T.Section}" />
                                <TextBlock Text="{Binding TotalFiles, Converter={StaticResource Cv.Count}}"
                                           Style="{StaticResource T.Metric}"
                                           Foreground="{StaticResource B.Magenta}" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource B.Line}" Margin="14,4" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ОБЩИЙ ВЕС" Style="{StaticResource T.Section}" />
                                <TextBlock Text="{Binding TotalBytes, Converter={StaticResource Cv.Bytes}}"
                                           Style="{StaticResource T.Metric}"
                                           Foreground="{StaticResource B.Cyan}" />
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource B.Line}" Margin="14,4" />

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ПРОСМОТРЕНО" Style="{StaticResource T.Section}" />
                                <TextBlock Text="{Binding SeenFiles, Converter={StaticResource Cv.Count}}"
                                           Style="{StaticResource T.Metric}" />
                            </StackPanel>
                            <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource B.Line}" Margin="14,4" />

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="ПАПОК ПРОЙДЕНО" Style="{StaticResource T.Section}" />
                                <TextBlock Text="{Binding SeenDirectories, Converter={StaticResource Cv.Count}}"
                                           Style="{StaticResource T.Metric}" />
                            </StackPanel>
                            <Rectangle Grid.Column="7" Width="1" Fill="{StaticResource B.Line}" Margin="14,4" />

                            <!-- Звание барахольщика -->
                            <StackPanel Grid.Column="8" VerticalAlignment="Center">
                                <TextBlock Text="ДИАГНОЗ" Style="{StaticResource T.Section}" />
                                <TextBlock Text="{Binding HoarderTitle}" Style="{StaticResource T.Title}"
                                           Foreground="{StaticResource B.Lime}"
                                           Visibility="{Binding HoarderTitle, Converter={StaticResource Cv.NotEmpty}}" />
                                <TextBlock Text="{Binding HoarderComment}" Style="{StaticResource T.Body}"
                                           Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="ещё не обследовано" Style="{StaticResource T.Body}"
                                           Visibility="{Binding HoarderTitle, Converter={StaticResource Cv.NotEmpty}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== ОСНОВНАЯ ОБЛАСТЬ ===================== -->
                <Grid Grid.Row="2" Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="306" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="380" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="332" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ ЛЕВАЯ ПАНЕЛЬ: где и что искать ============ -->
                    <Border Grid.Column="0" Style="{StaticResource S.Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="90" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Источники -->
                            <StackPanel Grid.Row="0" Margin="16,16,16,0">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="ГДЕ КОПАЕМ" Style="{StaticResource T.Section}"
                                               Margin="0" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RootsSummary}" Style="{StaticResource T.Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Cyan}" />
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,0,0,7">
                                    <Button Content="Весь компьютер" Style="{StaticResource S.Btn.Ghost}"
                                            Margin="0,0,4,0" Padding="8,8" FontSize="11.5"
                                            ToolTip="Все локальные и съёмные диски"
                                            Command="{Binding PresetDrivesCommand}" />
                                    <Button Content="Мои папки" Style="{StaticResource S.Btn.Ghost}"
                                            Margin="4,0,0,0" Padding="8,8" FontSize="11.5"
                                            ToolTip="Картинки, Музыка, Видео, Загрузки, Рабочий стол, Документы"
                                            Command="{Binding PresetUserCommand}" />
                                </UniformGrid>

                                <UniformGrid Columns="2">
                                    <Button Content="+ Добавить папку" Style="{StaticResource S.Btn.Ghost}"
                                            Margin="0,0,4,0" Padding="8,8" FontSize="11.5"
                                            Command="{Binding AddFolderCommand}" />
                                    <Button Content="Очистить" Style="{StaticResource S.Btn.Ghost}"
                                            Margin="4,0,0,0" Padding="8,8" FontSize="11.5"
                                            Command="{Binding ClearRootsCommand}" />
                                </UniformGrid>
                            </StackPanel>

                            <!-- Список выбранных папок -->
                            <Grid Grid.Row="1" Margin="16,12,10,0">
                                <ListBox ItemsSource="{Binding Roots}"
                                         Style="{StaticResource S.List}"
                                         ItemContainerStyle="{StaticResource S.RootItem}"
                                         ItemTemplate="{StaticResource Tpl.Root}"
                                         Padding="0,0,6,0" />
                                <TextBlock Text="Список пуст. Выберите пресет или добавьте папку вручную."
                                           Style="{StaticResource T.Body}" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="10,0,16,0"
                                           Visibility="{Binding Roots.Count, Converter={StaticResource Cv.NotEmpty}, ConverterParameter=invert}" />
                            </Grid>

                            <!-- Фильтры -->
                            <StackPanel Grid.Row="2" Margin="16,16,16,16">
                                <Rectangle Height="1" Fill="{StaticResource B.Line}" Margin="0,0,0,14" />

                                <TextBlock Text="ЧТО ИЩЕМ" Style="{StaticResource T.Section}" />
                                <WrapPanel Margin="0,0,0,4">
                                    <ToggleButton Content="Картинки" Style="{StaticResource S.Chip}"
                                                  IsChecked="{Binding ScanImages}"
                                                  ToolTip="jpg, jpeg, png, gif, bmp, webp, tiff, ico" />
                                    <ToggleButton Content="Музыка" Style="{StaticResource S.Chip}"
                                                  IsChecked="{Binding ScanAudio}"
                                                  ToolTip="mp3, wav, flac, m4a, ogg, opus, wma, aac" />
                                    <ToggleButton Content="Видео" Style="{StaticResource S.Chip}"
                                                  IsChecked="{Binding ScanVideo}"
                                                  ToolTip="mp4, avi, mkv, mov, webm, wmv, flv, m4v, 3gp" />
                                </WrapPanel>

                                <Grid Margin="0,8,0,2">
                                    <TextBlock Text="МИНИМАЛЬНЫЙ РАЗМЕР" Style="{StaticResource T.Section}"
                                               Margin="0" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding MinSizeText}" Style="{StaticResource T.Caption}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource B.Amber}" />
                                </Grid>
                                <Slider Style="{StaticResource S.Slider}" Minimum="0" Maximum="50"
                                        Value="{Binding MinSizeMb}" Margin="0,0,0,12"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True" />

                                <CheckBox Content="Только то, что открывается внутри"
                                          Style="{StaticResource S.Check}"
                                          IsChecked="{Binding OnlyPreviewable}"
                                          ToolTip="Рулетка не будет предлагать mkv, flac, webm и прочее, что WPF не умеет показывать" />
                                <CheckBox Content="Скрытые и системные файлы"
                                          Style="{StaticResource S.Check}"
                                          IsChecked="{Binding IncludeHidden}" />
                                <CheckBox Content="Служебные папки (Windows, AppData…)"
                                          Style="{StaticResource S.Check}" Margin="0"
                                          IsChecked="{Binding IncludeSystemFolders}"
                                          ToolTip="Сильно замедляет обход и выдаёт кучу иконок из кеша" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ ЦЕНТР: сцена с находкой ============ -->
                    <Border Grid.Column="2" Style="{StaticResource S.Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="200" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Шапка: кнопка сканирования -->
                            <Grid Grid.Row="0" Margin="18,18,18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusPhrase}" Style="{StaticResource T.Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FiltersSummary}" Style="{StaticResource T.Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button Content="СКАНИРОВАТЬ  (F5)"
                                            Style="{StaticResource S.Btn.Primary}"
                                            Command="{Binding ScanCommand}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource Cv.Bool}, ConverterParameter=invert}" />
                                    <Button Content="ОСТАНОВИТЬ"
                                            Style="{StaticResource S.Btn.Ghost}" Padding="18,11"
                                            Command="{Binding CancelCommand}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource Cv.Bool}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Сцена предпросмотра -->
                            <Border Grid.Row="1" Margin="18,0,18,0" CornerRadius="12"
                                    Background="#33000000" BorderBrush="{StaticResource B.Line}"
                                    BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- Картинка -->
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IsImagePreview, Converter={StaticResource Cv.Bool}}" />

                                    <!-- Видео -->
                                    <MediaElement x:Name="PreviewMedia"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                  ScrubbingEnabled="True" Stretch="Uniform"
                                                  Volume="{Binding Volume}"
                                                  MediaOpened="OnMediaOpened"
                                                  MediaFailed="OnMediaFailed"
                                                  MediaEnded="OnMediaEnded"
                                                  Visibility="{Binding IsVideoPreview, Converter={StaticResource Cv.Bool}}" />

                                    <!-- Аудио: обложка-заглушка с эквалайзером -->
                                    <Grid Visibility="{Binding IsAudioPreview, Converter={StaticResource Cv.Bool}}">
                                        <Border Width="190" Height="190" CornerRadius="95"
                                                Background="{StaticResource B.Accent}" Opacity="0.14" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="52" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource B.Lime}" />
                                            <TextBlock Text="{Binding CurrentFile.Name}"
                                                       Style="{StaticResource T.Title}" Margin="0,16,0,0"
                                                       MaxWidth="380" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       MaxHeight="42" />
                                            <!-- Живой эквалайзер -->
                                            <StackPanel x:Name="Equalizer" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" Margin="0,20,0,0"
                                                        Height="46" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Формат без поддержки -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Margin="30"
                                                Visibility="{Binding IsUnsupported, Converter={StaticResource Cv.Bool}}">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="42" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource B.Amber}" />
                                        <TextBlock Text="Этот формат внутри не показать"
                                                   Style="{StaticResource T.Title}" Margin="0,14,0,0"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Windows Media не тянет этот кодек. Откройте файл во внешнем плеере."
                                                   Style="{StaticResource T.Body}" Margin="0,6,0,0"
                                                   MaxWidth="330" TextAlignment="Center" />
                                        <Button Content="Открыть снаружи" Style="{StaticResource S.Btn.Ghost}"
                                                HorizontalAlignment="Center" Margin="0,14,0,0"
                                                Command="{Binding OpenFileCommand}" />
                                    </StackPanel>

                                    <!-- Пустая сцена -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Margin="30"
                                                Visibility="{Binding IsStageEmpty, Converter={StaticResource Cv.Bool}}">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="46" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource B.TextFaint}" />
                                        <TextBlock Text="Тут появится случайная находка"
                                                   Style="{StaticResource T.Title}" Margin="0,16,0,0"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Выберите папки слева и запустите сканирование. Дальше рулетка сама решит, что вам показать."
                                                   Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                                   MaxWidth="340" TextAlignment="Center" />
                                    </StackPanel>

                                    <!-- Оверлей рулетки -->
                                    <Border Background="#CC0B0A14"
                                            Visibility="{Binding IsSpinning, Converter={StaticResource Cv.Bool}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="РУЛЕТКА КРУТИТСЯ" Style="{StaticResource T.Caption}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource B.Magenta}" />
                                            <TextBlock Text="{Binding SpinLabel}" Style="{StaticResource T.Display}"
                                                       Margin="0,10,0,0" MaxWidth="420"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <ProgressBar Style="{StaticResource S.Progress}" Width="230"
                                                         Margin="0,18,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Прогресс сканирования -->
                                    <Border VerticalAlignment="Bottom" Background="#CC0B0A14" Padding="14,10"
                                            Visibility="{Binding IsScanning, Converter={StaticResource Cv.Bool}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentFolder}" Style="{StaticResource T.Mono}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <ProgressBar Style="{StaticResource S.Progress}" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Плеер -->
                            <Grid Grid.Row="2" Margin="18,12,18,0"
                                  Visibility="{Binding HasPlayableMedia, Converter={StaticResource Cv.Bool}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="PlayButton" Content="&#xE768;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                                        Style="{StaticResource S.Btn.Icon}" Click="OnPlayPause"
                                        ToolTip="Играть / пауза" />
                                <Button Grid.Column="1" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="12" Style="{StaticResource S.Btn.Icon}" Click="OnStop"
                                        ToolTip="Стоп" />

                                <Grid Grid.Column="2" Margin="8,0,10,0">
                                    <Slider x:Name="Seek" Style="{StaticResource S.Slider}" Minimum="0"
                                            Maximum="1" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="OnSeekPress"
                                            PreviewMouseLeftButtonUp="OnSeekRelease" />
                                </Grid>

                                <TextBlock Grid.Column="3" x:Name="TimeLabel" Text="0:00 / 0:00"
                                           Style="{StaticResource T.Mono}" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <TextBlock Grid.Column="4" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{StaticResource B.TextDim}" />
                                <Slider Grid.Column="5" Style="{StaticResource S.Slider}" Width="86"
                                        Minimum="0" Maximum="1" Value="{Binding Volume}"
                                        VerticalAlignment="Center" ToolTip="Громкость" />
                            </Grid>

                            <!-- Вердикт и данные о файле -->
                            <Grid Grid.Row="3" Margin="18,14,18,0"
                                  Visibility="{Binding HasCurrent, Converter={StaticResource Cv.Bool}}">
                                <Border Style="{StaticResource S.CardFlat}" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CurrentFile.Name}"
                                                       Style="{StaticResource T.Title}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Border Background="#1AFFFFFF" CornerRadius="999" Padding="9,3"
                                                        Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding CurrentSizeText}"
                                                               Style="{StaticResource T.Caption}"
                                                               Foreground="{StaticResource B.Cyan}" />
                                                </Border>
                                                <Border Background="#1AFFFFFF" CornerRadius="999" Padding="9,3">
                                                    <TextBlock Text="{Binding CurrentAgeText}"
                                                               Style="{StaticResource T.Caption}"
                                                               Foreground="{StaticResource B.Amber}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding CurrentPathShort}"
                                                   Style="{StaticResource T.Mono}" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   ToolTip="{Binding CurrentFile.Path}" />

                                        <Border Grid.Row="2" Margin="0,11,0,0" CornerRadius="8"
                                                Background="#14FF3D9A" Padding="11,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE946;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Margin="0,1,9,0" VerticalAlignment="Top"
                                                           Foreground="{StaticResource B.Magenta}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Verdict}"
                                                           Style="{StaticResource T.Body}"
                                                           Foreground="{StaticResource B.Text}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Кнопки действий -->
                            <Grid Grid.Row="4" Margin="18,14,18,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource S.Btn.Primary}"
                                        Command="{Binding SpinCommand}" HorizontalAlignment="Stretch"
                                        ToolTip="Ctrl+R">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center" />
                                        <TextBlock Text="КРУТИТЬ РУЛЕТКУ" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button Content="Открыть" Style="{StaticResource S.Btn.Ghost}"
                                            Margin="0,0,6,0" Command="{Binding OpenFileCommand}"
                                            ToolTip="Ctrl+O" />
                                    <Button Content="Папка" Style="{StaticResource S.Btn.Ghost}"
                                            Margin="0,0,6,0" Command="{Binding OpenFolderCommand}"
                                            ToolTip="Показать в проводнике" />
                                    <Button Content="Путь" Style="{StaticResource S.Btn.Ghost}"
                                            Command="{Binding CopyPathCommand}"
                                            ToolTip="Ctrl+C — скопировать полный путь" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ ПРАВАЯ ПАНЕЛЬ: итоги и список ============ -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" MinHeight="180" />
                        </Grid.RowDefinitions>

                        <!-- Итоги -->
                        <Border Grid.Row="0" Style="{StaticResource S.Card}">
                            <StackPanel>
                                <TextBlock Text="СОСТАВ БАРАХЛА" Style="{StaticResource T.Section}" />

                                <ItemsControl ItemsSource="{Binding KindStats}"
                                              ItemTemplate="{StaticResource Tpl.KindStat}" />

                                <TextBlock Text="Сканирование ещё не запускалось."
                                           Style="{StaticResource T.Body}"
                                           Visibility="{Binding KindStats.Count, Converter={StaticResource Cv.NotEmpty}, ConverterParameter=invert}" />

                                <Grid Visibility="{Binding TopFolders.Count, Converter={StaticResource Cv.NotEmpty}}">
                                    <StackPanel>
                                        <Rectangle Height="1" Fill="{StaticResource B.Line}" Margin="0,6,0,14" />
                                        <TextBlock Text="ГЛАВНЫЕ РАССАДНИКИ" Style="{StaticResource T.Section}" />
                                        <ItemsControl ItemsSource="{Binding TopFolders}"
                                                      ItemTemplate="{StaticResource Tpl.Folder}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Список находок -->
                        <Border Grid.Row="2" Style="{StaticResource S.Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="16,16,16,10">
                                    <TextBlock Text="ВСЁ НАЙДЕННОЕ" Style="{StaticResource T.Section}"
                                               Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FindingsCaption}" Style="{StaticResource T.Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Cyan}" />
                                </Grid>

                                <TextBox Grid.Row="1" Margin="16,0,16,10"
                                         Style="{StaticResource S.Search}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                         ToolTip="Поиск по имени файла и имени папки" />

                                <WrapPanel Grid.Row="2" Margin="14,0,14,8">
                                    <RadioButton Content="как нашлось" Style="{StaticResource S.Tab}"
                                                 IsChecked="{Binding SortNatural}" />
                                    <RadioButton Content="жирные" Style="{StaticResource S.Tab}"
                                                 IsChecked="{Binding SortBiggest}" />
                                    <RadioButton Content="древние" Style="{StaticResource S.Tab}"
                                                 IsChecked="{Binding SortOldest}" />
                                    <RadioButton Content="свежие" Style="{StaticResource S.Tab}"
                                                 IsChecked="{Binding SortNewest}" />
                                </WrapPanel>

                                <Grid Grid.Row="3" Margin="16,0,10,16">
                                    <ListBox ItemsSource="{Binding Findings}"
                                             Style="{StaticResource S.List}"
                                             ItemContainerStyle="{StaticResource S.ListItem}"
                                             ItemTemplate="{StaticResource Tpl.Finding}"
                                             SelectionChanged="OnFindingSelected"
                                             Padding="0,0,6,0" />
                                    <TextBlock Text="Здесь появится список всего найденного."
                                               Style="{StaticResource T.Body}" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="10,0,16,0"
                                               Visibility="{Binding Findings.Count, Converter={StaticResource Cv.NotEmpty}, ConverterParameter=invert}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===================== НИЖНЯЯ ПОЛОСА ===================== -->
                <Border Grid.Row="3" Margin="16,0,16,16" CornerRadius="12"
                        Background="{StaticResource B.Glass}"
                        BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- История показов -->
                        <TextBlock Grid.Column="0" Text="БЫЛО" Style="{StaticResource T.Caption}"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />

                        <Grid Grid.Column="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding History.Count, Converter={StaticResource Cv.NotEmpty}}">
                                <ItemsControl ItemsSource="{Binding History}"
                                              ItemTemplate="{StaticResource Tpl.History}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="история показов пока пуста"
                                       Style="{StaticResource T.Body}" VerticalAlignment="Center"
                                       Visibility="{Binding History.Count, Converter={StaticResource Cv.NotEmpty}, ConverterParameter=invert}" />
                        </Grid>

                        <!-- Служебные счётчики -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource T.Caption}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       MaxWidth="280" TextTrimming="CharacterEllipsis" />
                            <Border Background="#1AFFFFFF" CornerRadius="999" Padding="9,4" Margin="0,0,5,0">
                                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource T.Mono}"
                                           FontSize="10.5" />
                            </Border>
                            <Border Background="#1AFFFFFF" CornerRadius="999" Padding="9,4"
                                    ToolTip="Папки и файлы, к которым не дали доступ"
                                    Visibility="{Binding Errors, Converter={StaticResource Cv.NotEmpty}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="закрыто: " Style="{StaticResource T.Mono}" FontSize="10.5" />
                                    <TextBlock Text="{Binding Errors, Converter={StaticResource Cv.Count}}"
                                               Style="{StaticResource T.Mono}" FontSize="10.5"
                                               Foreground="{StaticResource B.Amber}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

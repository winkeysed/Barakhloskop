<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Базовые цвета ============ -->
    <Color x:Key="C.Void">#FF07060D</Color>
    <Color x:Key="C.Base">#FF0E0D18</Color>
    <Color x:Key="C.Surface">#FF151423</Color>
    <Color x:Key="C.Card">#FF1A1930</Color>
    <Color x:Key="C.CardHi">#FF23213C</Color>
    <Color x:Key="C.Line">#FF2E2B4A</Color>

    <Color x:Key="C.Magenta">#FFFF3D9A</Color>
    <Color x:Key="C.Violet">#FF9B5CFF</Color>
    <Color x:Key="C.Cyan">#FF32E0F0</Color>
    <Color x:Key="C.Lime">#FFB4FF3D</Color>
    <Color x:Key="C.Amber">#FFFFC24B</Color>

    <Color x:Key="C.Text">#FFF2EFFF</Color>
    <Color x:Key="C.TextDim">#FFA6A0C7</Color>
    <Color x:Key="C.TextFaint">#FF6E688F</Color>

    <!-- ============ Кисти ============ -->
    <SolidColorBrush x:Key="B.Void" Color="{StaticResource C.Void}" />
    <SolidColorBrush x:Key="B.Base" Color="{StaticResource C.Base}" />
    <SolidColorBrush x:Key="B.Card" Color="{StaticResource C.Card}" />
    <SolidColorBrush x:Key="B.CardHi" Color="{StaticResource C.CardHi}" />
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />

    <SolidColorBrush x:Key="B.Magenta" Color="{StaticResource C.Magenta}" />
    <SolidColorBrush x:Key="B.Violet" Color="{StaticResource C.Violet}" />
    <SolidColorBrush x:Key="B.Cyan" Color="{StaticResource C.Cyan}" />
    <SolidColorBrush x:Key="B.Lime" Color="{StaticResource C.Lime}" />
    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}" />

    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}" />

    <SolidColorBrush x:Key="B.Glass" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.GlassHi" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="B.Shade" Color="#66000000" />

    <!-- Фон окна: глубокий градиент -->
    <LinearGradientBrush x:Key="B.WindowBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF120F22" />
        <GradientStop Offset="0.45" Color="#FF0C0B16" />
        <GradientStop Offset="1" Color="#FF14101F" />
    </LinearGradientBrush>

    <!-- Основной акцентный градиент (кнопки, заголовки) -->
    <LinearGradientBrush x:Key="B.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource C.Magenta}" />
        <GradientStop Offset="1" Color="{StaticResource C.Violet}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.AccentHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFF57AA" />
        <GradientStop Offset="1" Color="#FFAE77FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Cool" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource C.Cyan}" />
        <GradientStop Offset="1" Color="#FF4C7BFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Fresh" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource C.Lime}" />
        <GradientStop Offset="1" Color="{StaticResource C.Cyan}" />
    </LinearGradientBrush>

    <!-- Заголовок карточки-панели -->
    <LinearGradientBrush x:Key="B.CardBg" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Offset="0" Color="#FF1D1B33" />
        <GradientStop Offset="1" Color="#FF161426" />
    </LinearGradientBrush>

    <!-- Бордюр с подсветкой сверху -->
    <LinearGradientBrush x:Key="B.CardBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40FFFFFF" />
        <GradientStop Offset="0.5" Color="#18FFFFFF" />
        <GradientStop Offset="1" Color="#0CFFFFFF" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="B.Spotlight" GradientOrigin="0.5,0.1" Center="0.5,0.1" RadiusX="0.9" RadiusY="0.8">
        <GradientStop Offset="0" Color="#33FF3D9A" />
        <GradientStop Offset="1" Color="#00000000" />
    </RadialGradientBrush>

    <!-- ============ Метрики ============ -->
    <CornerRadius x:Key="R.Card">14</CornerRadius>
    <CornerRadius x:Key="R.Button">10</CornerRadius>
    <CornerRadius x:Key="R.Chip">999</CornerRadius>

    <!-- ============ Тени ============ -->
    <DropShadowEffect x:Key="FX.Card" BlurRadius="28" ShadowDepth="6" Direction="270"
                      Color="#000000" Opacity="0.55" />
    <DropShadowEffect x:Key="FX.Glow" BlurRadius="22" ShadowDepth="0"
                      Color="{StaticResource C.Magenta}" Opacity="0.55" />
    <DropShadowEffect x:Key="FX.GlowCyan" BlurRadius="18" ShadowDepth="0"
                      Color="{StaticResource C.Cyan}" Opacity="0.5" />

    <!-- ============ Типографика ============ -->
    <FontFamily x:Key="F.Ui">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
    </Style>

    <!-- Заголовок секции: мелкие капсы с разрядкой -->
    <Style x:Key="T.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
    </Style>

    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
    </Style>

    <Style x:Key="T.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

</ResourceDictionary>
